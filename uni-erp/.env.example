# نواة ERP الجامعي — قالب البيئة. انسخه إلى .env وعدّل القيم (cp .env.example .env)
# الأسطر المعلَّقة بـ # هي القيم الافتراضية؛ المتغيرات الفعلية في بيئة التشغيل لها الأولوية.

# ---- التشغيل ----
# PORT=3000
# HOST=127.0.0.1              # 0.0.0.0 للاستضافة أو للتجربة على الهاتف عبر الشبكة المحلية
# SESSION_HOURS=8             # مدة الجلسة بالساعات

# ---- قاعدة البيانات والمجلدات ----
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/unierp   # إلزامي: النظام يعمل على PostgreSQL حصراً (لا SQLite)
#   عند تشغيل الاختبارات: يحتاج المستخدم صلاحية CREATEDB لأن كل مسار/‏:memory: يأخذ قاعدة مشتقة مستقلة
# DB_PATH=./data/uni-erp.db
# UPLOAD_DIR=./data/uploads
# LOG_DIR=./data/logs
# LOG_LEVEL=info              # error | warn | info

# ---- الأمان (اقرأ docs/SECURITY.md قبل النشر) ----
# SCRYPT_N=32768              # تكلفة تجزئة كلمات المرور؛ لا تُخفض في الإنتاج
# AUDIT_KEY=                   # مفتاح سلسلة سجل التدقيق؛ يُولَّد في data/audit.key إن تُرك فارغاً
# REVOKE_PASSWORD=             # لمرة واحدة: يبطل كلمة مرور مكشوفة في كل حساب يستعملها عند التشغيل، ثم احذفه
# ROTATE_SIGNING_KEY=2026-11   # لمرة واحدة لكل قيمة: يبدل مفتاح التوقيع ويحذف النسخ غير المشفرة، والوثائق الموقعة قبله تفشل في التحقق
# SIGNING_KEY=                # مفتاح توقيع الوثائق؛ يُولَّد تلقائياً في data/secret.key إن تُرك فارغاً (احفظه مع النسخ الاحتياطي!)
# COOKIE_SECURE=1             # إلزامي خلف HTTPS: يمنع تسريب الكوكي عبر http
# TRUST_PROXY=1               # اضبطه =1 خلف موازن تحميل أو وسيط (load balancer) ليُعتمد X-Forwarded-For
# SEED_PASSWORD=              # كلمة مرور قوية للحسابات التأسيسية بدلاً من القيمة الافتراضية
# FORCE_SEED_PASSWORD_CHANGE=1 # إجبار الحسابات التأسيسية على تغيير كلمة المرور فور أول تسجيل دخول
# DEMO_MODE=1                  # للعرض التجريبي فقط: يعيد كلمة مرور كل الحسابات، ومنها الطلاب، إلى SEED_PASSWORD عند كل تشغيل، ويفعّل الحسابات المعطلة، ويتيح تبديل الحساب محلياً. يُرفض التشغيل به مع NODE_ENV=production. لا تستخدمه مع بيانات حقيقية
# SESSION_IDLE_MIN=120         # مهلة خمول الجلسة بالدقائق، و0 يعطلها
# RATE_IP_MAX=120000           # سقف طلبات العنوان الواحد في الدقيقة؛ حد المستخدم بعد الدخول مستقل عنه
# WAF_TRUSTED_IPS=1.2.3.4      # عناوين الجامعة الخارجة عبر NAT: لا تُحظر ولا يُطبَّق عليها حد الطلبات (مفصولة بفواصل)
# DB_SSL_VERIFY=1              # التحقق من شهادة قاعدة البيانات عند TLS، أو DB_SSL_CA=مسار شهادة الجهة
# STRICT_ADMIN_SOD=1          # فصل المهام الحساسة (المالية/الرواتب/المشتريات/العلامات) عن حساب مدير النظام التقني (ISO 27001 A.6.1.2)

# ---- الهوية العامة (روابط التحقق ورموز QR داخل الوثائق) ----
# UNIVERSITY_NAME=الجامعة السورية للعلوم الأمنية   # يجب أن يحوي حروفاً عربية
# PUBLIC_URL=                 # العنوان العام https، مثال: https://erp.university.edu

# ---- النسخ الاحتياطي ----
# BACKUP_DIR=./data/backups  # الافتراضي: data/backups
# BACKUP_KEEP=14              # عدد النسخ المحتفظ بها
# BACKUP_HOUR=1               # ساعة الإنشاء التلقائي (UTC)
# BACKUP_AUTO=1               # مفعّل افتراضياً؛ 0 لإيقاف النسخ التلقائي. يتطلب pg_dump على الخادم
# BACKUP_PASSPHRASE=          # يُشفّر النسخ AES-256-GCM؛ ضعه إلزامياً في الإنتاج (النسخ تحوي بيانات الطلاب ومفتاح التوقيع)
# BACKUP_PUT_URL=             # عنوان PUT لرفع نسخة خارجية؛ اضبطه أو انسخ مجلد النسخ دورياً إلى وسيط آخر
# BACKUP_PUT_AUTH=            # ترويسة مصادقة للرفع الخارجي (Bearer ... مثلاً)

# ---- شهادة التوقيع X.509 (اختياري؛ دونها تُولَّد شهادة ذاتية الإصدار) ----
# SIGNING_PEM=                # PEM يحوي المفتاح الخاص RSA + الشهادة + السلسلة، أو base64 له
# SIGNING_PASSPHRASE=

# ---- الختم الزمني RFC 3161 (اختياري، يوثّق وقت إصدار الشهادات بطرف ثالث عبر HTTPS) ----
# TSA_URL=https://timestamp.digicert.com

# ---- إشعارات الجوال Web Push ----
# VAPID_PUBLIC_KEY=           # تُولَّد تلقائياً إن تُركت فارغة
# VAPID_PRIVATE_KEY=
# PUSH_ALLOW_HOSTS=           # قواعد مضيفات خدمات الدفع الإضافية مفصولة بفواصل

# عدد عمليات الخادم على المنفذ نفسه (الافتراضي 1). الموقع يتوقف عن النمو عند انتظار القاعدة لا عند المعالج، فزد العمليات مع الحمل.
# كل عملية تأخذ نحو 150 MB واتصالين بالقاعدة: اضبط max_connections في PostgreSQL على ضعف العدد على الأقل مع هامش.
# WEB_CONCURRENCY=8
# عدد خيوط العمليات الثقيلة لكل عملية (الافتراضي 1 مع تعدد العمليات، و2 بدونه)
# HEAVY_POOL=1
# الحد الأقصى لاتصالات القاعدة لكل خيط (الافتراضي 20)
# DB_POOL_MAX=20

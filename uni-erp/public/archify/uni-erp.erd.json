        { "name": "status", "type": "varchar(24)" },
        { "name": "created_at", "type": "bigint" }
      ]
    }
  ],
  "relationships": [
    { "id": "r_user_unit", "from": "users", "to": "org_units", "fromCardinality": "many", "toCardinality": "one" },
    { "id": "r_req_user", "from": "requests", "to": "users", "fromCardinality": "many", "toCardinality": "one" },
    { "id": "r_req_unit", "from": "requests", "to": "org_units", "fromCardinality": "many", "toCardinality": "one" },
    { "id": "r_corr_unit", "from": "corr_docs", "to": "org_units", "fromCardinality": "many", "toCardinality": "one" },
    { "id": "r_corr_user", "from": "corr_docs", "to": "users", "fromCardinality": "many", "toCardinality": "one" },
    { "id": "r_doc_req", "from": "documents", "to": "requests", "fromCardinality": "many", "toCardinality": "one" },
    { "id": "r_emp_user", "from": "hr_employees", "to": "users", "fromCardinality": "many", "toCardinality": "one" },
    { "id": "r_emp_unit", "from": "hr_employees", "to": "org_units", "fromCardinality": "many", "toCardinality": "one" },
    { "id": "r_fin_user", "from": "fin_entries", "to": "users", "fromCardinality": "many", "toCardinality": "one" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "High-Frequency Composite Indexes (031_high_frequency_table_indexes)",
      "items": [
        "users(role, status, unit_id) and org_units(parent_id, kind) power O(1) L1/Redis cache warming",
        "requests(status, current_unit_id, created_at DESC) eliminates full-table scans on My Desk"
      ]
    },
    {
      "dot": "cyan",
      "title": "Write-Through Cache Invalidation",
      "items": [
        "Mutations on users, org_units, requests, or corr_docs selectively invalidate only their affected namespace",
        "Sustains 10,000+ concurrent readers and 50+ write transactions/sec under benchmark load"
      ]
    }
  ]
}

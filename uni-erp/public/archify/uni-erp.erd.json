{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "title": "Uni-ERP v12 — High-Frequency Relational Schema (ERD)",
    "locale": "en",
    "output": "erd.html",
    "quality_profile": "standard",
    "views": [
      {
        "id": "identity_org",
        "label": "Identity & Org Hierarchy",
        "focus": ["users", "org_units"],
        "note": "Cached in L1/Redis memory with composite indexes on role, unit_id, and student_no."
      },
      {
        "id": "workflows",
        "label": "Requests & Correspondence",
        "focus": ["requests", "corr_docs", "documents"],
        "note": "High-throughput tables handling 10+ writes/sec with Ed25519 signed document outputs."
      },
      {
        "id": "hr_finance",
        "label": "HR, Payroll & Finance Ledger",
        "focus": ["hr_employees", "fin_entries"],
        "note": "Double-entry financial ledger and biometric/contract employee records."
      }
    ]
  },
  "layout": {
    "mode": "grid",
    "gapY": 42,
    "gapX": 74
  },
  "entities": [
    {
      "id": "org_units",
      "label": "org_units",
      "tag": "identity",
      "row": 0,
      "col": 0,
      "attributes": [
        { "name": "id", "type": "integer", "key": "pk" },
        { "name": "code", "type": "varchar(32)", "key": "uk" },
        { "name": "name", "type": "varchar(160)" },
        { "name": "kind", "type": "varchar(32)" },
        { "name": "parent_id", "type": "integer" }
      ]
    },
    {
      "id": "users",
      "label": "users",
      "tag": "identity",
      "row": 1,
      "col": 0,
      "attributes": [
        { "name": "id", "type": "integer", "key": "pk" },
        { "name": "username", "type": "varchar(64)", "key": "uk" },
        { "name": "role", "type": "varchar(32)" },
        { "name": "unit_id", "type": "integer", "key": "fk", "references": "org_units.id" },
        { "name": "student_no", "type": "varchar(32)", "key": "uk" },
        { "name": "status", "type": "varchar(24)" }
      ]
    },
    {
      "id": "requests",
      "label": "requests",
      "tag": "operations",
      "row": 0,
      "col": 1,
      "attributes": [
        { "name": "id", "type": "integer", "key": "pk" },
        { "name": "req_no", "type": "varchar(40)", "key": "uk" },
        { "name": "student_id", "type": "integer", "key": "fk", "references": "users.id" },
        { "name": "current_unit_id", "type": "integer", "key": "fk", "references": "org_units.id" },
        { "name": "service_code", "type": "varchar(40)" },
        { "name": "status", "type": "varchar(24)" },
        { "name": "created_at", "type": "bigint" }
      ]
    },
    {
      "id": "corr_docs",
      "label": "corr_docs",
      "tag": "operations",
      "row": 1,
      "col": 1,
      "attributes": [
        { "name": "id", "type": "integer", "key": "pk" },
        { "name": "ref_no", "type": "varchar(48)", "key": "uk" },
        { "name": "from_unit_id", "type": "integer", "key": "fk", "references": "org_units.id" },
        { "name": "created_by", "type": "integer", "key": "fk", "references": "users.id" },
        { "name": "priority", "type": "varchar(16)" },
        { "name": "status", "type": "varchar(24)" }

      "col": 2,
      "attributes": [
        { "name": "id", "type": "integer", "key": "pk" },
        { "name": "emp_no", "type": "varchar(32)", "key": "uk" },
        { "name": "user_id", "type": "integer", "key": "fk", "references": "users.id" },
        { "name": "unit_id", "type": "integer", "key": "fk", "references": "org_units.id" },
